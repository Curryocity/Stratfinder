{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Main Debug (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/main-debug",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Run Main Release (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/main-release",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "build-release"
        },
        {
            "name": "Run Test (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/test",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "build-test"
        },
        {
            "name": "Run Sandbox (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sandbox",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "build-sandbox"
        }
    ]
}
